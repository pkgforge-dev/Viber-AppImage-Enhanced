#!/bin/sh

if [ "$1" = '--auto-start' ] || [ "${APPIMAGE_VIBER_AUTOSTART:-0}" = 1 ]; then
	if [ "$1" = '--auto-start' ]; then
    	shift
    fi
	mkdir -p "${HOST_XDG_CONFIG_HOME}/autostart"
	echo "[Desktop Entry]
Type=Application
Name=Viber
Exec=$APPIMAGE StartInBackground
X-GNOME-Autostart-enabled=true" > "${HOST_XDG_CONFIG_HOME}/autostart/com.viber.Viber.desktop"
fi
